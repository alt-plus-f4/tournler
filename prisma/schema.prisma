generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum UserRole {
  USER
  MODERATOR
  TOURNAMENT_ADMIN
  CONTENT_ADMIN
  ADMIN

  @@map("user_role")
}

// Which game a tournament or team belongs to. Existing rows are CS2.
enum Game {
  CS2
  LOL

  @@map("game")
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED

  @@map("tournament_status")
}

enum TournamentType {
  ONLINE
  OFFLINE

  @@map("tournament_type")
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  ROUND_ROBIN
  DOUBLE_ELIMINATION

  @@map("tournament_format")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED

  @@map("match_status")
}

enum BracketSlot {
  WINNERS
  LOSERS
  GRAND_FINAL
  THIRD_PLACE

  @@map("bracket_slot")
}

enum MatchSlot {
  TEAM_A
  TEAM_B
  // Captain-draft pickups only (see PickupMode.CAPTAIN_DRAFT): a joined player who hasn't been
  // drafted onto a side yet. Never used outside a draft-mode pickup's join/draft flow — every
  // other MatchSlot usage (veto turn order, stat rows, map/match winners) only ever sees
  // TEAM_A/TEAM_B, since a match can't start until the draft (like veto) is complete and every
  // participant has a real side.
  POOL

  @@map("match_slot")
}

enum PickupMode {
  // Today's behavior: any signed-in player joins Side A or Side B directly. Default for all
  // existing/new pickups unless CAPTAIN_DRAFT is chosen at creation.
  OPEN
  // Old-FPL-style captain draft: the first 2 joiners become captains (one per side), the next 8
  // join a shared pool, then captains alternately draft 4 players each onto their side (see
  // src/lib/tournaments/draft.ts) until the pool is empty and every side has 5.
  CAPTAIN_DRAFT

  @@map("pickup_mode")
}

enum MapActionType {
  BAN
  PICK
  DECIDER

  @@map("map_action_type")
}

model Account {
  id                String   @id @default(uuid()) @map("id") @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  type              String   @map("type") @db.VarChar
  provider          String   @map("provider") @db.VarChar
  providerAccountId String   @map("provider_account_id") @db.VarChar
  refresh_token     String?  @map("refresh_token")
  access_token      String?  @map("access_token")
  expires_at        Int?     @map("expires_at")
  token_type        String?  @map("token_type") @db.VarChar
  scope             String?  @map("scope") @db.VarChar
  id_token          String?  @map("id_token")
  session_state     String?  @map("session_state") @db.VarChar
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @map("expires") @db.Timestamp(6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id    String  @id @default(uuid()) @map("id") @db.Uuid
  email String  @unique @map("email") @db.VarChar
  name  String? @map("name") @db.VarChar
  image String? @map("image") @db.VarChar
  bio   String? @default("Software developer by day, gamer by night 67") @map("bio") @db.VarChar

  // Profile privacy: whether linked accounts are shown on the public profile.
  showDiscord Boolean @default(true) @map("show_discord")
  showSteam   Boolean @default(true) @map("show_steam")
  showRiot    Boolean @default(true) @map("show_riot")

  isOnboardingCompleted Boolean   @default(false) @map("is_onboarding_completed")
  emailVerified         DateTime? @map("email_verified") @db.Timestamp(6)
  role                  UserRole  @default(USER) @map("role")

  discord DiscordAccount?
  steam   SteamAccount?

  // One team per game (enforced in src/lib/teams/membership.ts): a player can be on a CS2 team and a
  // LoL team at the same time. Replaces the old single cs2TeamId column.
  teams              Cs2Team[]           @relation(name: "TeamMembers")
  captainOf          Cs2Team[]           @relation(name: "CS2TeamCaptain")
  // Games the player said they play during onboarding (drives which account-linking steps show).
  games              Game[]              @default([]) @map("games")
  riot               RiotAccount?
  cs2TeamInvitations Cs2TeamInvitation[]

  organizedTournaments Cs2Tournament[]    @relation("TournamentOrganizers")
  playerMatchStats     PlayerMatchStat[]
  badges               UserBadge[]
  newsPosts            NewsPost[]
  newsComments         NewsComment[]
  forumThreads         ForumThread[]
  forumReplies         ForumReply[]
  bans                 UserBan[] @relation("BannedUser")
  bansIssued           UserBan[] @relation("BanIssuer")
  bansLifted           UserBan[] @relation("BanLifter")
  forumVotes           ForumVote[]
  matchParticipations  MatchParticipant[]
  draftPicks           MatchDraftPick[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

}

model Cs2Tournament {
  id   Int    @id @default(autoincrement()) @map("id")
  name String @unique @map("name")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  bannerUrl   String? @map("banner_url")
  logoUrl     String? @map("logo_url")
  description String? @map("description")

  prizePool    Int?      @map("prize_pool")
  teams        Cs2Team[] @relation("TournamentTeams")
  teamCapacity Int       @map("team_capacity")

  // CS2 tournaments get hosted MatchZy servers; LoL tournaments don't (results are reported).
  game Game @default(CS2) @map("game")

  location String           @map("location")
  type     TournamentType   @map("type")
  status   TournamentStatus @map("status")
  format   TournamentFormat @default(SINGLE_ELIMINATION) @map("format")

  bestOf  Int      @default(1) @map("best_of")
  mapPool String[] @default([]) @map("map_pool")

  isFeatured    Boolean @default(false) @map("is_featured")
  featuredOrder Int?    @map("featured_order")
  isSystem      Boolean @default(false) @map("is_system")

  organizerId String @map("organizer_id")
  organizer   User   @relation("TournamentOrganizers", fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  matches Matches[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
}

model Cs2Team {
  id Int @id @default(autoincrement()) @map("id")

  name       String  @map("name")
  logo       String? @map("logo")
  background String? @map("background")

  game Game @default(CS2) @map("game")

  members User[] @relation("TeamMembers")

  // One captaincy per user per game (see @@unique below).
  capitanId String? @map("capitan_id")
  capitan   User?   @relation("CS2TeamCaptain", fields: [capitanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  teamInvitations Cs2TeamInvitation[] @relation(name: "TeamInvitations")
  Cs2Tournament   Cs2Tournament?      @relation("TournamentTeams", fields: [cs2TournamentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cs2TournamentId Int?                @map("cs2_tournament_id")

  matchesAsTeamA   Matches[]         @relation("MatchTeamA")
  matchesAsTeamB   Matches[]         @relation("MatchTeamB")
  matchesAsWinner  Matches[]         @relation("MatchWinner")
  playerMatchStats PlayerMatchStat[]
  mapActions       MatchMapAction[]
  mapWins          MatchMap[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, game])
  @@unique([capitanId, game])
  @@index([cs2TournamentId])
  @@index([game])
  @@map("cs2_teams")
}

model Cs2TeamInvitation {
  id Int @id @default(autoincrement()) @map("id")

  teamId Int     @map("team_id")
  team   Cs2Team @relation(name: "TeamInvitations", fields: [teamId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teamId])
  @@index([userId])
  @@map("cs2_team_invitations")
}

model SteamAccount {
  id      String @id @default(uuid()) @map("id") @db.Uuid
  userId  String @unique @map("user_id") @db.Uuid
  steamId String @unique @map("steam_id") @db.VarChar
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model DiscordAccount {
  id          String @id @default(uuid()) @map("id") @db.Uuid
  userId      String @unique @map("user_id") @db.Uuid
  discordId   String @unique @map("discord_id") @db.VarChar
  accessToken String @map("access_token") @db.VarChar
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model VerificationToken {
  identifier String   @map("identifier") @db.VarChar
  token      String   @map("token") @db.VarChar
  expires    DateTime @map("expires") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([identifier, token])
}

model Matches {
  id           Int           @id @default(autoincrement()) @map("id")
  tournamentId Int           @map("tournament_id")
  tournament   Cs2Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  teamAId  Int?     @map("team_a_id")
  teamA    Cs2Team? @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId  Int?     @map("team_b_id")
  teamB    Cs2Team? @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  winnerId Int?     @map("winner_id")
  winner   Cs2Team? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: Cascade)

  // Pickup-match winner: pickup sides are MatchParticipant rows, not Cs2Teams, so there is no
  // Cs2Team id winnerId could reference. This records which side won instead. Mutually exclusive
  // with winnerId in practice — non-pickup matches use winnerId, pickups use winnerSide.
  winnerSide MatchSlot? @map("winner_side")

  scoreTeamA Int?     @map("score_team_a")
  scoreTeamB Int?     @map("score_team_b")
  matchDate  DateTime @map("match_date")

  // Nullable override of Cs2Tournament.bestOf for this specific match (null = inherit tournament default).
  bestOf Int? @map("best_of")

  status      MatchStatus @default(SCHEDULED) @map("status")
  round       Int         @default(1) @map("round")
  position    Int         @default(0) @map("position")
  bracketSlot BracketSlot @default(WINNERS) @map("bracket_slot")
  isPickup    Boolean     @default(false) @map("is_pickup")
  // Only meaningful when isPickup is true (see PickupMode) — null for non-pickup matches.
  pickupMode PickupMode? @map("pickup_mode")

  // Pickup-lobby-only display names ("Side A"/"Side B" otherwise) — set by that side's captain
  // (the first player to join it) via PATCH /api/matches/[matchId]/team-name. Unused for
  // real Cs2Team matches, which already have a real team name via teamA/teamB.
  teamAName String? @map("team_a_name")
  teamBName String? @map("team_b_name")

  startedAt   DateTime? @map("started_at")
  pausedAt    DateTime? @map("paused_at")
  completedAt DateTime? @map("completed_at")

  // Fallback for matches with no MatchMap rows (pickups, and any bo1 match created without a
  // veto-generated map — see finalizeVeto). Series matches with real MatchMap rows store the
  // demo per-map on MatchMap.demoUrl instead, since each map in a bo3 gets its own demo.
  demoUrl String? @map("demo_url")

  // Plain (non-relational) self-pointers: explicit bracket-feeder wiring computed once at
  // generation time. Deliberately NOT modeled as Prisma @relation fields — self-relation
  // cascade cycles require onUpdate/onDelete: NoAction, which relationMode="prisma" (emulated
  // FKs, no real DB constraint) does not support. Plain columns avoid that entirely; callers
  // fetch the target row by id when they need to follow the pointer.
  nextMatchId   Int?       @map("next_match_id")
  nextMatchSlot MatchSlot? @map("next_match_slot")

  nextLoserMatchId   Int?       @map("next_loser_match_id")
  nextLoserMatchSlot MatchSlot? @map("next_loser_match_slot")

  gameServer   GameServer?
  playerStats  PlayerMatchStat[]
  participants MatchParticipant[]
  draftPicks   MatchDraftPick[]
  mapActions   MatchMapAction[]
  maps         MatchMap[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tournamentId])
  @@index([teamAId])
  @@index([teamBId])
  @@index([winnerId])
  @@index([tournamentId, bracketSlot, round])
  @@index([nextMatchId])
  @@index([nextLoserMatchId])
  @@map("matches")
}

model GameServer {
  id      Int     @id @default(autoincrement()) @map("id")
  matchId Int     @unique @map("match_id")
  match   Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  connectIp String @map("connect_ip")
  port      Int    @map("port")
  password  String @map("password")

  status GameServerStatus @default(PENDING) @map("status")

  // Set once RCON successfully pushes this match's config (teams/players/maps/password) to the
  // real server. Null means either not attempted yet, or the push failed — see the warning
  // surfaced by startMatch()/the game-server route, and the manual sync fallback.
  matchConfigLoadedAt DateTime? @map("match_config_loaded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([matchId])
  @@map("game_servers")
}

enum GameServerStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  @@map("game_server_status")
}

model MatchMapAction {
  id      Int     @id @default(autoincrement()) @map("id")
  matchId Int     @map("match_id")
  match   Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Null only for the system-generated DECIDER action (the last remaining map, not chosen by either team) — or for any pickup-match action, which uses `side` instead (pickups have no Cs2Team).
  teamId Int?     @map("team_id")
  team   Cs2Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Pickup-match veto actor: pickup sides are MatchParticipant rows, not Cs2Teams, so there is no
  // Cs2Team id `teamId` could reference. Null for non-pickup actions (which use `teamId`) and for
  // the system-generated DECIDER action either way. Mirrors PlayerMatchStat's teamId/side split.
  side MatchSlot? @map("side")

  action  MapActionType @map("action")
  mapName String        @map("map_name")
  order   Int           @map("order")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([matchId, order])
  @@unique([matchId, mapName])
  @@index([matchId])
  @@map("match_map_actions")
}

model MatchMap {
  id      Int     @id @default(autoincrement()) @map("id")
  matchId Int     @map("match_id")
  match   Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  mapName String @map("map_name")
  order   Int    @map("order")

  scoreTeamA Int?     @map("score_team_a")
  scoreTeamB Int?     @map("score_team_b")
  winnerId   Int?     @map("winner_id")
  winner     Cs2Team? @relation(fields: [winnerId], references: [id], onDelete: Cascade)

  // Pickup-match map winner: pickup sides are MatchParticipant rows, not Cs2Teams, so there is no
  // Cs2Team id `winnerId` could reference. Null for non-pickup maps (which use `winnerId`).
  // Mirrors Matches.winnerSide/PlayerMatchStat.side/MatchMapAction.side.
  winnerSide MatchSlot? @map("winner_side")

  status MatchStatus @default(SCHEDULED) @map("status")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Set once MatchZy's demo upload for this map arrives (see POST /api/matches/[matchId]/demo) —
  // one demo per map in a bo1/bo3 series.
  demoUrl String? @map("demo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([matchId, order])
  @@unique([matchId, mapName])
  @@index([matchId])
  @@map("match_maps")
}

model PlayerMatchStat {
  id Int @id @default(autoincrement()) @map("id")

  matchId Int     @map("match_id")
  match   Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Real (non-pickup) matches use teamId, a real Cs2Team. Pickup matches have no Cs2Team (sides
  // are MatchParticipant rows, not teams — see Matches.winnerSide for the same distinction), so
  // they record which side the player was on instead. Mutually exclusive in practice.
  teamId Int?     @map("team_id")
  team   Cs2Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  side   MatchSlot? @map("side")

  kills   Int @default(0) @map("kills")
  deaths  Int @default(0) @map("deaths")
  assists Int @default(0) @map("assists")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@index([teamId])
  @@map("player_match_stats")
}

model Badge {
  id          Int     @id @default(autoincrement()) @map("id")
  name        String  @unique @map("name")
  description String? @map("description")
  icon        String  @map("icon")
  color       String  @default("#facc15") @map("color")
  isOverlay   Boolean @default(false) @map("is_overlay")
  // Uploaded trophy artwork (Vercel Blob). When set it is shown instead of the built-in `icon`.
  imageUrl    String? @map("image_url")

  awards UserBadge[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("badges")
}

model UserBadge {
  id Int @id @default(autoincrement()) @map("id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId Int   @map("badge_id")
  badge   Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now()) @map("awarded_at")

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

model NewsPost {
  id            Int      @id @default(autoincrement()) @map("id")
  title         String   @map("title")
  blurb         String   @map("blurb")
  imageUrl      String?  @map("image_url")
  link          String?  @map("link")
  isFeatured    Boolean  @default(false) @map("is_featured")
  featuredOrder Int?     @map("featured_order")
  publishedAt   DateTime @default(now()) @map("published_at")
  // EditorJS output ({ time, blocks, version }). Null for legacy posts that only have blurb/link.
  content       Json?    @map("content")

  comments NewsComment[]

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@map("news_posts")
}

enum FeaturedSource {
  TOURNAMENTS
  NEWS
  MIXED
}

enum FeaturedLayout {
  GRID
  CAROUSEL
}

model HomepageSettings {
  id             Int            @id @default(1)
  featuredSource FeaturedSource @default(TOURNAMENTS) @map("featured_source")
  featuredLayout FeaturedLayout @default(GRID) @map("featured_layout")

  // Homepage rewatch/VOD player, shown as the hero when no match is live. All nullable: null
  // falls back to the built-in default VOD (see src/components/home/rewatch-defaults.ts).
  rewatchVideoId   String? @map("rewatch_video_id")
  rewatchTitle     String? @map("rewatch_title")
  rewatchTeamA     String? @map("rewatch_team_a")
  rewatchTeamB     String? @map("rewatch_team_b")
  rewatchTeamALogo String? @map("rewatch_team_a_logo")
  rewatchTeamBLogo String? @map("rewatch_team_b_logo")

  // HLTV-style "recent forum posts" block on the homepage sidebar.
  showForumPosts Boolean @default(true) @map("show_forum_posts")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("homepage_settings")
}

model MatchParticipant {
  id Int @id @default(autoincrement()) @map("id")

  matchId Int     @map("match_id")
  match   Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  side MatchSlot @map("side")
  // CAPTAIN_DRAFT pickups only (see PickupMode) — the first joiner onto each side, before any
  // picks happen. Always false for OPEN pickups and non-pickup matches. Kept as an explicit flag
  // rather than inferred from join order, since a drafted pool player's `side` also becomes
  // TEAM_A/TEAM_B once picked, at which point join order alone can't tell captain from pick.
  isCaptain Boolean @default(false) @map("is_captain")

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
  @@map("match_participants")
}

/** One captain's pick in a CAPTAIN_DRAFT pickup (see PickupMode) — mirrors MatchMapAction's role for veto: an ordered, append-only history the draft's current-turn/completion state is derived from. */
model MatchDraftPick {
  id Int @id @default(autoincrement()) @map("id")

  matchId Int     @map("match_id")
  match   Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Which captain made this pick.
  captainSide MatchSlot @map("captain_side")
  // Which pool player got drafted onto captainSide.
  pickedUserId String @map("picked_user_id")
  pickedUser   User   @relation(fields: [pickedUserId], references: [id], onDelete: Cascade)

  order Int @map("order")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([matchId, order])
  @@unique([matchId, pickedUserId])
  @@index([matchId])
  @@map("match_draft_picks")
}

model NewsComment {
  id Int @id @default(autoincrement()) @map("id")

  postId Int      @map("post_id")
  post   NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  text String @map("text")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@index([authorId])
  @@map("news_comments")
}

enum ForumCategory {
  GENERAL
  COUNTER_STRIKE
  TOURNAMENTS
  OFF_TOPIC

  @@map("forum_category")
}

// HLTV-style text forum: any signed-in user can open a thread and reply. Text only, no images.
model ForumThread {
  id Int @id @default(autoincrement()) @map("id")

  title    String        @map("title")
  body     String        @map("body")
  category ForumCategory @default(GENERAL) @map("category")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  isPinned Boolean @default(false) @map("is_pinned")
  isLocked Boolean @default(false) @map("is_locked")

  replies ForumReply[]
  votes   ForumVote[]

  // Net upvotes minus downvotes, kept in sync with ForumVote rows for cheap sorting.
  score Int @default(0) @map("score")

  // Bumped on every reply so "recent posts" can sort threads by latest activity.
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([lastActivityAt])
  @@index([category, lastActivityAt])
  @@index([authorId])
  @@map("forum_threads")
}

model ForumReply {
  id Int @id @default(autoincrement()) @map("id")

  threadId Int         @map("thread_id")
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String @map("body")

  // Reply chain (Reddit/HLTV-style nesting). Null = top-level reply to the thread. A plain column
  // rather than a self-relation: relationMode = "prisma" can't emulate the cascade cycle. Replies
  // with children are soft-deleted (deletedAt) so the chain under them stays readable.
  parentId  Int?      @map("parent_id")
  deletedAt DateTime? @map("deleted_at")

  score Int         @default(0) @map("score")
  votes ForumVote[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("forum_replies")
}

// Site-wide suspension history. A ban is active while liftedAt is null and expiresAt is null
// (permanent) or in the future. Banned users can still browse, but getAuthSession() treats them
// as signed out, so every authenticated action is refused (see src/lib/bans.ts).
model UserBan {
  id Int @id @default(autoincrement()) @map("id")

  userId String @map("user_id")
  user   User   @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  reason String @map("reason")

  bannedById String? @map("banned_by_id")
  bannedBy   User?   @relation("BanIssuer", fields: [bannedById], references: [id], onDelete: SetNull)

  // Null = permanent.
  expiresAt DateTime? @map("expires_at")

  liftedAt   DateTime? @map("lifted_at")
  liftedById String?   @map("lifted_by_id")
  liftedBy   User?     @relation("BanLifter", fields: [liftedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, liftedAt])
  @@index([createdAt])
  @@map("user_bans")
}

// One vote per user per thread or reply: value is +1 or -1. Exactly one of threadId/replyId is set.
model ForumVote {
  id Int @id @default(autoincrement()) @map("id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadId Int?         @map("thread_id")
  thread   ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  replyId Int?        @map("reply_id")
  reply   ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  value Int @map("value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, threadId])
  @@unique([userId, replyId])
  @@index([threadId])
  @@index([replyId])
  @@map("forum_votes")
}

// A player's League of Legends identity. Linked by entering a Riot ID (gameName#tagLine + region),
// resolved to a puuid through Riot's account-v1 API, then proven by setting a requested profile icon.
// Required to register for LoL tournaments (src/lib/games/eligibility.ts).
model RiotAccount {
  id String @id @default(uuid()) @map("id")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  puuid    String @unique @map("puuid")
  gameName String @map("game_name")
  tagLine  String @map("tag_line")
  // Platform routing value, e.g. "euw1", "na1".
  region   String @map("region")

  // Ownership challenge: set this profile icon in the LoL client, then verify before it expires.
  verificationIconId    Int?      @map("verification_icon_id")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verifiedAt            DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("riot_accounts")
}
