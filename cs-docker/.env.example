# Copy to cs-docker/.env before running `docker compose up` from this directory.
# Defines a fixed-size pool of persistent CS2 servers (see docker-compose.yml and
# ../CS2_SERVER_GUIDE.md). Each server's port/RCON port/passwords must also appear as an entry
# in the app's own CS2_SERVER_POOL env var (see ../.examplenv) so the Next.js app can actually
# reach and control it.

# Steam Game Server login token (see https://steamcommunity.com/dev/managegameservers) — shared
# by every server in the pool.
SRCDS_TOKEN=

# --- Server 1 ---
CS2_SERVER_1_NAME=[Tournler] CS2 Dedicated Server 01
CS2_SERVER_1_PORT=27015
CS2_SERVER_1_RCON_PORT=27016
CS2_SERVER_1_TV_PORT=27020
CS2_SERVER_1_PW=changeme1           # players' connect password (overwritten per match by the app)
CS2_SERVER_1_RCONPW=changeme-rcon1
CS2_SERVER_1_TV_PW=changeme-tv1

# --- Server 2 ---
CS2_SERVER_2_NAME=[Tournler] CS2 Dedicated Server 02
CS2_SERVER_2_PORT=27025
CS2_SERVER_2_RCON_PORT=27026
CS2_SERVER_2_TV_PORT=27030
CS2_SERVER_2_PW=changeme2
CS2_SERVER_2_RCONPW=changeme-rcon2
CS2_SERVER_2_TV_PW=changeme-tv2

# To add a 3rd/4th/etc server: copy the block above with a new index, pick new non-colliding
# ports, add a matching cs2-dedicated-0N service to docker-compose.yml, and add a matching
# entry to CS2_SERVER_POOL in the app's own .env.
