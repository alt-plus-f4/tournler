# Copy to /etc/tournler-agent.env on the game host (chmod 600) and fill in.

# Shared secret between this agent and the Tournler app (24+ chars). The same value goes into
# Admin -> Servers -> Add host. Generate: openssl rand -base64 36
AGENT_SECRET=

# Where the agent listens. Keep it on localhost and put Caddy/nginx (TLS) in front, or bind to a
# private network address (WireGuard/Tailscale). Never expose plain HTTP to the internet:
# create requests carry the new server's passwords.
AGENT_HOST=127.0.0.1
AGENT_PORT=8787

# Where the shared game files and per-server data live. Needs ~60 GB free for the shared install,
# plus a few hundred MB per server.
AGENT_DATA_DIR=/srv/cs2

# The cs-docker/settings folder from this repo (pre.sh, post.sh, game/csgo/cfg/MatchZy).
SETTINGS_DIR=/opt/tournler/cs-docker/settings

# Steam game server login tokens (https://steamcommunity.com/dev/managegameservers, app id 730),
# comma separated. Steam ties a token to one running server, so you need one per server on this
# host. Servers beyond the number of tokens are refused.
SRCDS_TOKENS=

# overlay = every server shares one read-only copy of the game (Linux, run as root).
# copy    = full ~50 GB copy per server (no overlayfs available).
SHARE_MODE=overlay

# Optional.
# CS2_IMAGE=joedwards32/cs2
# CUSTOM_CSS_DIR=/opt/tournler/cs-docker/.build-cache/counterstrikesharp-custom
# STEAMCMD_PATH=/home/steam/steamcmd/steamcmd.sh
